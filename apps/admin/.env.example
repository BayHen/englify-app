NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Chỉ bật sau khi migration Admin RLS được áp trên project và đã kiểm tra quyền.
NEXT_PUBLIC_SUPABASE_ADMIN_ENABLED=false
# Chỉ bật sau khi đã áp migration Real English và kiểm tra quyền admin.
NEXT_PUBLIC_REAL_ENGLISH_HYBRID_ENABLED=true
# Bật trong Admin sau khi xác minh cron.job đang active trên Supabase.
NEXT_PUBLIC_REAL_ENGLISH_CRON_ENABLED=false

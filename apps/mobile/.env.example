# Public base URL; replace localhost with your computer's LAN IP on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public values from Supabase project settings; never use a service role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

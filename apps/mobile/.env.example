# Set exactly one API URL. Metro's --tunnel does not expose FastAPI.
# Same LAN (native device; HTTP web page on this machine):
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:8000/api/v1
EXPO_PUBLIC_SUPABASE_PLAN_ENABLED=false
EXPO_PUBLIC_SUPABASE_WRITING_ENABLED=false
# For HTTPS Expo Web or devices outside the LAN, replace it with a separately
# hosted/tunneled HTTPS FastAPI URL, e.g. https://YOUR_API_HOST/api/v1.
# Never put a database password or service role key in EXPO_PUBLIC_*.
# Public values from Supabase project settings; never use a service role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Chỉ bật sau khi đã áp migration Real English và kiểm tra RLS trên dự án Supabase.
EXPO_PUBLIC_REAL_ENGLISH_LESSONS_ENABLED=false

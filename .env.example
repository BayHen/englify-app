# Sao chép thành .env để dùng ở máy phát triển; không commit giá trị bí mật.
API_HOST=127.0.0.1
API_PORT=8000
ENGLIFY_ENVIRONMENT=development
ENGLIFY_LOG_LEVEL=INFO
ENGLIFY_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Database-backed endpoints and Alembic need a PostgreSQL URL.
# ENGLIFY_DATABASE_URL=postgresql+psycopg://englify:<password>@localhost:5432/englify
# Supabase Auth issuer used by FastAPI for JWT verification (asymmetric signing key required).
# ENGLIFY_SUPABASE_URL=https://your-project.supabase.co
# Docker Compose requires a local password. Never commit the real value.
POSTGRES_PASSWORD=
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

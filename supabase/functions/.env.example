# Cấu hình cục bộ bằng --env-file; không commit file .env thật.
TRANSLATE_ALLOWED_ORIGINS=http://localhost:8081
EDGE_ALLOWED_ORIGINS=http://localhost:8081
# Tùy chọn: LanguageTool tự lưu trữ, không gửi bài viết đến dịch vụ công cộng.
LANGUAGETOOL_URL=
# Chỉ dùng trong Edge Secrets; tuyệt đối không đặt vào EXPO_PUBLIC_* hoặc NEXT_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_GENERATION_ENABLED=false
AI_FREE_TIER_CONFIRMED=false
AI_DAILY_MAX_REQUESTS=10
AI_DAILY_MAX_OUTPUT_TOKENS=12000
AI_MONTHLY_MAX_ESTIMATED_COST_USD=0
# Bí mật Cron riêng, tạo ngẫu nhiên khi bật lịch; không dùng key công khai.
REAL_ENGLISH_CRON_SECRET=
# Chỉ bật sau khi rà quyền sử dụng dữ liệu đầu ra Free Dictionary API.
DICTIONARY_ENRICHMENT_ENABLED=false
